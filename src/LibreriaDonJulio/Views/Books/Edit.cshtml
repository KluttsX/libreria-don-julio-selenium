@model LibreriaDonJulio.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<h2>Edit Book</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row mb-3">
        <div class="col-6">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="col-6">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" required />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" required />
        </div>

        <div class="col-6">
            <label asp-for="CoverUrl" class="form-label"></label>
            <input asp-for="CoverUrl" class="form-control" required />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Isbn" class="form-label"></label>
        <input asp-for="Isbn" class="form-control" required />
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control"
                   type="number" min="0" step="0.01" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="col-6">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control"
                   type="number" min="0" step="1" required />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}