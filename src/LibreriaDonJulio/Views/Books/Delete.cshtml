@model LibreriaDonJulio.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h2>Delete Book</h2>

<p>Are you sure you want to delete this book?</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">CoverUrl</dt>
    <dd class="col-sm-10">@Model.CoverUrl</dd>

    <dt class="col-sm-2">Isbn</dt>
    <dd class="col-sm-10">@Model.Isbn</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Price.ToString("F2")</dd>

    <dt class="col-sm-2">Stock</dt>
    <dd class="col-sm-10">@Model.Stock</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">

    <button type="submit" class="btn btn-danger">
        Delete Book
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>