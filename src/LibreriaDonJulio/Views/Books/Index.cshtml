@model IEnumerable<LibreriaDonJulio.Models.Book>

@{
  ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Books</h2>

    <a asp-action="Create" class="btn btn-primary">
        Register Book
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cover</th>
            <th>Title</th>
            <th>Author</th>
            <th>Description</th>           
            <th>Isbn</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td><img src="@book.CoverUrl" alt="@book.Title" style="width: 70px; height: 100px; object-fit: cover;" /></td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Description</td>            
                <td>@book.Isbn</td>
                <td>@book.Price.ToString("F2")</td>
                <td>@book.Stock</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-warning btn-sm mb-3">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


@if (!Model.Any())
{
    <p class="text-muted">No books registered.</p>
}